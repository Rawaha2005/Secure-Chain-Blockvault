import subprocess
import sys
import importlib.util

# =====================================================
# REQUIRED PACKAGES
# =====================================================

REQUIRED_PACKAGES = {
    "fastapi": "fastapi",
    "uvicorn": "uvicorn",
    "sqlalchemy": "sqlalchemy",
    "python-dotenv": "dotenv",
    "psycopg2-binary": "psycopg2",
    "python-jose[cryptography]": "jose",
    "cryptography": "cryptography",
    "passlib[bcrypt]": "passlib",
    "bcrypt==4.1.3": "bcrypt",
    "python-multipart": "multipart",
    "email-validator": "email_validator",
   
}

# =====================================================
# HELPERS
# =====================================================

def run_command(command):
    result = subprocess.run(command)
    return result.returncode == 0


def is_installed(module):
    return importlib.util.find_spec(module) is not None


# =====================================================
# PIP
# =====================================================

def ensure_pip():
    print("\nChecking pip...\n")

    if run_command([sys.executable, "-m", "pip", "--version"]):
        print("[OK] pip is installed.\n")
        return

    print("[INFO] Installing pip...\n")

    if not run_command([sys.executable, "-m", "ensurepip", "--upgrade"]):
        print("[ERROR] Unable to install pip.")
        sys.exit(1)


# =====================================================
# UPGRADE PIP
# =====================================================

def upgrade_pip():
    print("Updating pip...\n")

    run_command([
        sys.executable,
        "-m",
        "pip",
        "install",
        "--upgrade",
        "pip",
        "setuptools",
        "wheel"
    ])


# =====================================================
# INSTALL PACKAGES
# =====================================================

def install_packages():

    print("\nChecking required packages...\n")

    for package, module in REQUIRED_PACKAGES.items():

        if is_installed(module):
            print(f"[OK] {package}")
            continue

        print(f"[INSTALL] {package}")

        success = run_command([
            sys.executable,
            "-m",
            "pip",
            "install",
            package
        ])

        if success:
            print(f"[SUCCESS] {package}\n")
        else:
            print(f"[FAILED] {package}")
            sys.exit(1)


# =====================================================
# MAIN
# =====================================================

def main():

    print("=" * 60)
    print(" Blockchain Digital Evidence Management System ")
    print(" Environment Setup ")
    print("=" * 60)

    ensure_pip()

    upgrade_pip()

    install_packages()

    print("\n" + "=" * 60)
    print(" Environment Ready ")
    print("=" * 60)


if __name__ == "__main__":
    main()